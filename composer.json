{
  "name": "ucof/app",
  "type": "project",
  "description": "UCOF application foundation",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.60",
    "livewire/livewire": "^3.0",
    "mongodb/laravel-mongodb": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "fakerphp/faker": "^1.23",
    "nunomaduro/collision": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php artisan test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
